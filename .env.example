# Copier ce fichier en ".env" et renseigner de vraies valeurs. Ne jamais commit ".env".

# Mot de passe d'accès à l'outil, sous forme de hash (jamais le mot de passe en clair).
# Générer avec : php -r "echo password_hash('votre-mot-de-passe', PASSWORD_DEFAULT).PHP_EOL;"
APP_PASSWORD_HASH=

# Clé de chiffrement des jetons d'API stockés en base, encodée en base64 (32 octets).
# Générer avec : php -r "echo base64_encode(random_bytes(SODIUM_CRYPTO_SECRETBOX_KEYBYTES)).PHP_EOL;"
APP_ENCRYPTION_KEY=

# URL publique du site (https://...), SANS slash final. Requise uniquement pour les exécutions
# hors navigateur (le cron de publication programmée) : Instagram doit pouvoir récupérer les
# images uploadées via une URL publique, que le script ne peut pas déduire d'une requête HTTP
# puisqu'il n'y en a pas. Optionnelle sinon (déduite de la requête en cours).
APP_PUBLIC_URL=
